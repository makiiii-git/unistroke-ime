<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        通信の用途は 2 つだけ。
          1. ネット変換（Google 日本語入力 CGI API）… 既定オフのオプトイン
          2. アプリと拡張辞書の更新確認（GitHub）… アプリ画面を開いたときだけ
        入力中（IME サービス）に外へ出るのは 1 を有効にした場合のみ。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 更新 APK をシステムのインストーラーへ渡すために要る -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        音声入力（入力枠の長押し）のマイク。
        録音するのは長押しで始めたセッションのあいだだけで、終わったら
        認識器ごと破棄してマイクを手放す。既定では端末内音声認識だけを使うので、
        音声も認識結果も端末から出ない（設定で明示的に切り替えたときを除く）。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Android 11 以降は、問い合わせる相手を宣言しないと
        SpeechRecognizer から音声認識サービスが「無い」ものとして見える。
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.UniStroke">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_activity_label"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".LicenseActivity"
            android:exported="false"
            android:label="@string/license_activity_label" />

        <!--
            練習パッドを画面下端（実際の IME と同じ位置）に固定するレイアウトなので、
            トレーニング中は縦向きに固定する。
        -->
        <activity
            android:name=".TrainingActivity"
            android:exported="false"
            android:label="@string/training_activity_label"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!--
            マイクの許可を求めるためだけの透明な画面（IME サービスからは権限を
            要求できないため）。履歴にも残さず、可否が決まったら即座に閉じる。
        -->
        <activity
            android:name=".VoicePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".UniStrokeIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 更新 APK を content:// で渡す。cacheDir/updates だけを公開する。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
