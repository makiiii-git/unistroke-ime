# --- ビルド生成物 -----------------------------------------------------------
.gradle/
.kotlin/
build/
app/build/

# --- 環境依存の設定（各自の環境で作られる） ---------------------------------
# SDK の場所が入る。人によって違うのでコミットしない。
local.properties

# --- 署名鍵 -----------------------------------------------------------------
# 流出すると偽の更新 APK を作られる。絶対にコミットしない。
*.jks
*.keystore
*.p12
keystore.properties
signing.properties

# --- 辞書の素材 -------------------------------------------------------------
# tools/build_dictionary.py --fetch が Mozc から落としてくる素材（約 93 MB）。
# 生成物 app/src/main/assets/ondevice.dic のほうはコミットする（ビルドに必要）。
tools/mozc-src/

# --- Python 検証ハーネス ----------------------------------------------------
__pycache__/
*.py[cod]

# --- IDE / OS ---------------------------------------------------------------
.idea/
*.iml
.DS_Store
