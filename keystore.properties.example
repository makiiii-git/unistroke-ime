# リリース署名の設定テンプレート（3 つある方法のうち、いちばん手軽なもの）。
#
# 署名情報は次の順で解決される。先に見つかったものが使われる。
#
#   1. Gradle プロパティ
#        ./gradlew assembleRelease -PunistrokeStorePassword=…
#        環境変数 ORG_GRADLE_PROJECT_unistrokeStorePassword=…
#        ~/.gradle/gradle.properties に unistrokeStorePassword=…
#   2. 環境変数
#        UNISTROKE_STORE_FILE / UNISTROKE_STORE_PASSWORD
#        UNISTROKE_KEY_ALIAS  / UNISTROKE_KEY_PASSWORD
#   3. このファイル（keystore.properties）
#
# **パスワードを平文でディスクに置きたくない場合は 1 か 2 を使うこと。**
# CI では 1 が定石（シークレットを ORG_GRADLE_PROJECT_* として注入する）。
# macOS ならキーチェーンに入れて 2 に流し込む方法を README に書いてある。
#
# このファイルと *.jks は .gitignore 済み。絶対にコミットしないこと。
# 鍵を失うと、以後このアプリのアップデートを配れなくなる（別の鍵で署名した APK は
# 上書きインストールできない）。生成したら必ずオフラインにバックアップを取ること。
#
# 4 つすべてが揃い、かつ鍵ファイルが実在するときだけ署名される。
# 足りない場合は未署名 APK になり、何が足りないかがビルドログに出る。

# .jks ファイルのパス（プロジェクト直下からの相対パス、または絶対パス）
storeFile=release.jks

# キーストアのパスワード
storePassword=

# 鍵のエイリアス（keytool の -alias で指定したもの）
keyAlias=unistroke

# 鍵のパスワード（keytool でストアと同じにした場合は storePassword と同じ値）
keyPassword=
