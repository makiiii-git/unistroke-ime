# リリース署名の設定テンプレート。
#
# このファイルを keystore.properties にコピーして値を埋めると、
# assembleRelease が署名済み APK を出すようになる。
#
#   cp keystore.properties.example keystore.properties
#
# keystore.properties と *.jks は .gitignore 済み。絶対にコミットしないこと。
# 鍵を失うと、以後このアプリのアップデートを配れなくなる（別の鍵で署名した APK は
# 上書きインストールできない）。生成したら必ずオフラインにバックアップを取ること。

# .jks ファイルのパス（プロジェクト直下からの相対パス、または絶対パス）
storeFile=release.jks

# キーストアのパスワード
storePassword=

# 鍵のエイリアス（keytool の -alias で指定したもの）
keyAlias=unistroke

# 鍵のパスワード（keytool でストアと同じにした場合は storePassword と同じ値）
keyPassword=
